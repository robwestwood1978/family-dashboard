{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/family-dashboard.schema.json",
  "title": "Family Dashboard household configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "display",
    "theme",
    "people",
    "features",
    "calendar",
    "weather",
    "lists",
    "rooms",
    "media",
    "chores",
    "football",
    "school"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 2 },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "locale", "timezone"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "locale": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orientation", "kiosk", "legacy_ios", "default_view", "panel_path"],
      "properties": {
        "orientation": { "enum": ["landscape", "portrait"] },
        "kiosk": { "type": "boolean" },
        "legacy_ios": { "type": "boolean" },
        "default_view": {
          "enum": ["today", "calendar", "home", "music", "chores", "football", "school"]
        },
        "panel_path": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accent", "background", "surface", "text", "muted", "radius_px"],
      "properties": {
        "accent": { "$ref": "#/$defs/colour" },
        "background": { "$ref": "#/$defs/colour" },
        "surface": { "$ref": "#/$defs/colour" },
        "text": { "$ref": "#/$defs/colour" },
        "muted": { "$ref": "#/$defs/colour" },
        "radius_px": { "type": "integer", "minimum": 8, "maximum": 32 }
      }
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role", "colour"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "role": { "enum": ["parent", "child", "household"] },
          "colour": { "$ref": "#/$defs/colour" }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calendar", "home", "music", "chores", "football", "lists", "weather", "school"],
      "properties": {
        "calendar": { "type": "boolean" },
        "home": { "type": "boolean" },
        "music": { "type": "boolean" },
        "chores": { "type": "boolean" },
        "football": { "type": "boolean" },
        "lists": { "type": "boolean" },
        "weather": { "type": "boolean" },
        "school": { "type": "boolean" }
      }
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_type", "default_view", "rolling_days", "entities"],
      "properties": {
        "card_type": {
          "enum": ["custom:daylight-calendar-card", "custom:skylight-calendar-card"]
        },
        "default_view": { "enum": ["month", "week-compact", "week-standard", "agenda"] },
        "rolling_days": { "type": "integer", "minimum": 1, "maximum": 31 },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "entity_id", "label", "colour", "person_ids"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "entity_id": { "$ref": "#/$defs/calendarEntityId" },
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "colour": { "$ref": "#/$defs/colour" },
              "person_ids": {
                "type": "array",
                "items": { "$ref": "#/$defs/id" }
              }
            }
          }
        }
      }
    },
    "weather": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id"],
      "properties": {
        "entity_id": { "$ref": "#/$defs/weatherEntityId" }
      }
    },
    "lists": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reminders_entity", "shopping_entity"],
      "properties": {
        "reminders_entity": { "$ref": "#/$defs/todoEntityId" },
        "shopping_entity": { "$ref": "#/$defs/todoEntityId" }
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "area_id", "icon", "lights", "covers"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "area_id": { "$ref": "#/$defs/id" },
          "icon": { "$ref": "#/$defs/icon" },
          "lights": {
            "type": "array",
            "items": { "$ref": "#/$defs/lightEntityId" }
          },
          "covers": {
            "type": "array",
            "items": { "$ref": "#/$defs/coverEntityId" }
          },
          "climate": { "$ref": "#/$defs/climateEntityId" },
          "scene": { "$ref": "#/$defs/sceneEntityId" }
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_type", "initial_player", "players"],
      "properties": {
        "card_type": { "const": "custom:mediocre-multi-media-player-card" },
        "initial_player": { "$ref": "#/$defs/mediaPlayerEntityId" },
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entity_id", "name"],
            "properties": {
              "entity_id": { "$ref": "#/$defs/mediaPlayerEntityId" },
              "name": { "type": "string", "minLength": 1, "maxLength": 40 },
              "ma_entity_id": { "$ref": "#/$defs/mediaPlayerEntityId" },
              "speaker_group_entity_id": { "$ref": "#/$defs/entityId" },
              "can_be_grouped": { "type": "boolean" }
            }
          }
        }
      }
    },
    "chores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "users"],
      "properties": {
        "profile": { "const": "legacy-lite" },
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["person_id", "dashboard_helper_entity", "points_entity", "chores_entity"],
            "properties": {
              "person_id": { "$ref": "#/$defs/id" },
              "dashboard_helper_entity": { "$ref": "#/$defs/sensorEntityId" },
              "points_entity": { "$ref": "#/$defs/sensorEntityId" },
              "chores_entity": { "$ref": "#/$defs/sensorEntityId" }
            }
          }
        }
      }
    },
    "football": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_type", "entities"],
      "properties": {
        "card_type": { "const": "custom:teamtracker-card" },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entity_id", "label"],
            "properties": {
              "entity_id": { "$ref": "#/$defs/sensorEntityId" },
              "label": { "type": "string", "minLength": 1, "maxLength": 60 }
            }
          }
        }
      }
    },
    "school": { "$ref": "#/$defs/entityCollection" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "icon": { "type": "string", "pattern": "^mdi:[a-z0-9-]+$" },
    "entityId": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*\\.[a-z0-9_]+$" },
    "calendarEntityId": { "type": "string", "pattern": "^calendar\\.[a-z0-9_]+$" },
    "weatherEntityId": { "type": "string", "pattern": "^weather\\.[a-z0-9_]+$" },
    "todoEntityId": { "type": "string", "pattern": "^todo\\.[a-z0-9_]+$" },
    "lightEntityId": { "type": "string", "pattern": "^light\\.[a-z0-9_]+$" },
    "coverEntityId": { "type": "string", "pattern": "^cover\\.[a-z0-9_]+$" },
    "climateEntityId": { "type": "string", "pattern": "^climate\\.[a-z0-9_]+$" },
    "sceneEntityId": { "type": "string", "pattern": "^scene\\.[a-z0-9_]+$" },
    "mediaPlayerEntityId": { "type": "string", "pattern": "^media_player\\.[a-z0-9_]+$" },
    "sensorEntityId": { "type": "string", "pattern": "^sensor\\.[a-z0-9_]+$" },
    "colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "entityCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities"],
      "properties": {
        "entities": {
          "type": "array",
          "items": { "$ref": "#/$defs/entityId" }
        }
      }
    }
  }
}
