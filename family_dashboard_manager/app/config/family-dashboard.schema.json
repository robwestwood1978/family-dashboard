{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/family-dashboard.schema.json",
  "title": "Family Dashboard household configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "display",
    "theme",
    "people",
    "features",
    "calendar",
    "weather",
    "lists",
    "floorplan",
    "rooms",
    "media",
    "chores",
    "football",
    "school",
    "location"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 4 },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "locale", "timezone"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 60 },
        "locale": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orientation",
        "kiosk",
        "legacy_ios",
        "read_only",
        "default_view",
        "panel_path",
        "target_width",
        "target_height"
      ],
      "properties": {
        "orientation": { "enum": ["landscape", "portrait"] },
        "kiosk": { "type": "boolean" },
        "legacy_ios": { "type": "boolean" },
        "read_only": { "type": "boolean" },
        "default_view": {
          "enum": ["today", "calendar", "rooms", "family", "music", "football"]
        },
        "panel_path": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "target_width": { "type": "integer", "minimum": 768, "maximum": 2560 },
        "target_height": { "type": "integer", "minimum": 600, "maximum": 1600 }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accent",
        "background",
        "surface",
        "text",
        "muted",
        "radius_px",
        "backdrop_start",
        "backdrop_mid",
        "backdrop_end",
        "nav_background"
      ],
      "properties": {
        "accent": { "$ref": "#/$defs/colour" },
        "background": { "$ref": "#/$defs/colour" },
        "surface": { "$ref": "#/$defs/colour" },
        "text": { "$ref": "#/$defs/colour" },
        "muted": { "$ref": "#/$defs/colour" },
        "radius_px": { "type": "integer", "minimum": 8, "maximum": 32 },
        "backdrop_start": { "$ref": "#/$defs/colour" },
        "backdrop_mid": { "$ref": "#/$defs/colour" },
        "backdrop_end": { "$ref": "#/$defs/colour" },
        "nav_background": { "$ref": "#/$defs/colour" }
      }
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role", "colour"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "role": { "enum": ["parent", "child", "household"] },
          "colour": { "$ref": "#/$defs/colour" },
          "location_entity": { "$ref": "#/$defs/personEntityId" }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendar",
        "rooms",
        "family",
        "music",
        "chores",
        "football",
        "lists",
        "weather",
        "school",
        "location_map",
        "entry"
      ],
      "properties": {
        "calendar": { "type": "boolean" },
        "rooms": { "type": "boolean" },
        "family": { "type": "boolean" },
        "music": { "type": "boolean" },
        "chores": { "type": "boolean" },
        "football": { "type": "boolean" },
        "lists": { "type": "boolean" },
        "weather": { "type": "boolean" },
        "school": { "type": "boolean" },
        "location_map": { "type": "boolean" },
        "entry": { "const": false }
      }
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_view", "rolling_days", "entities"],
      "properties": {
        "initial_view": { "enum": ["listWeek", "dayGridMonth", "dayGridDay"] },
        "rolling_days": { "type": "integer", "minimum": 1, "maximum": 31 },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "entity_id", "label", "colour", "person_ids"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "entity_id": { "$ref": "#/$defs/calendarEntityId" },
              "label": { "type": "string", "minLength": 1, "maxLength": 40 },
              "colour": { "$ref": "#/$defs/colour" },
              "person_ids": {
                "type": "array",
                "items": { "$ref": "#/$defs/id" }
              },
              "category": { "enum": ["family", "personal", "school", "trip", "other"] }
            }
          }
        }
      }
    },
    "weather": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id"],
      "properties": {
        "entity_id": { "$ref": "#/$defs/weatherEntityId" }
      }
    },
    "lists": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reminders_entity", "shopping_entity"],
      "properties": {
        "reminders_entity": { "$ref": "#/$defs/todoEntityId" },
        "shopping_entity": { "$ref": "#/$defs/todoEntityId" }
      }
    },
    "floorplan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_floor", "floors"],
      "properties": {
        "default_floor": { "$ref": "#/$defs/id" },
        "floors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "aspect_ratio", "room_hotspots", "light_overlays"],
            "anyOf": [
              {
                "properties": { "base_image": {} },
                "required": ["base_image"]
              },
              {
                "properties": { "vacuum_map_entity": {} },
                "required": ["vacuum_map_entity"]
              }
            ],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "name": { "type": "string", "minLength": 1, "maxLength": 30 },
              "base_image": { "$ref": "#/$defs/localAssetUrl" },
              "vacuum_map_entity": { "$ref": "#/$defs/vacuumMapCameraEntityId" },
              "aspect_ratio": { "type": "number", "minimum": 0.5, "maximum": 4 },
              "night_image": { "$ref": "#/$defs/localAssetUrl" },
              "room_hotspots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["room_id", "points"],
                  "properties": {
                    "room_id": { "$ref": "#/$defs/id" },
                    "points": {
                      "type": "array",
                      "minItems": 3,
                      "items": { "$ref": "#/$defs/point" }
                    }
                  }
                }
              },
              "light_overlays": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["entity_id", "image"],
                  "properties": {
                    "entity_id": { "$ref": "#/$defs/lightEntityId" },
                    "image": { "$ref": "#/$defs/localAssetUrl" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "floor_id",
          "area_id",
          "icon",
          "lights",
          "covers",
          "scenes",
          "media_players"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "floor_id": { "$ref": "#/$defs/id" },
          "area_id": { "$ref": "#/$defs/id" },
          "icon": { "$ref": "#/$defs/icon" },
          "lights": {
            "type": "array",
            "items": { "$ref": "#/$defs/lightEntityId" }
          },
          "covers": {
            "type": "array",
            "items": { "$ref": "#/$defs/coverEntityId" }
          },
          "scenes": {
            "type": "array",
            "items": { "$ref": "#/$defs/sceneEntityId" }
          },
          "media_players": {
            "type": "array",
            "items": { "$ref": "#/$defs/mediaPlayerEntityId" }
          },
          "climate": { "$ref": "#/$defs/climateEntityId" },
          "temperature_sensor": { "$ref": "#/$defs/sensorEntityId" }
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_type", "initial_player", "players"],
      "properties": {
        "card_type": { "const": "custom:mediocre-multi-media-player-card" },
        "initial_player": { "$ref": "#/$defs/mediaPlayerEntityId" },
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entity_id", "name"],
            "properties": {
              "entity_id": { "$ref": "#/$defs/mediaPlayerEntityId" },
              "name": { "type": "string", "minLength": 1, "maxLength": 40 },
              "ma_entity_id": { "$ref": "#/$defs/mediaPlayerEntityId" },
              "speaker_group_entity_id": { "$ref": "#/$defs/entityId" },
              "can_be_grouped": { "type": "boolean" }
            }
          }
        }
      }
    },
    "chores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "users"],
      "properties": {
        "profile": { "const": "legacy-lite" },
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["person_id", "dashboard_helper_entity", "points_entity", "chores_entity"],
            "properties": {
              "person_id": { "$ref": "#/$defs/id" },
              "dashboard_helper_entity": { "$ref": "#/$defs/sensorEntityId" },
              "points_entity": { "$ref": "#/$defs/sensorEntityId" },
              "chores_entity": { "$ref": "#/$defs/sensorEntityId" }
            }
          }
        }
      }
    },
    "football": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "spotlight_team_codes",
        "index_entity",
        "gameweek_entity_prefix",
        "table_entity"
      ],
      "properties": {
        "provider": { "const": "fpl" },
        "spotlight_team_codes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "allOf": [
            { "contains": { "const": "TOT" } },
            { "contains": { "const": "AVL" } }
          ]
        },
        "index_entity": { "$ref": "#/$defs/sensorEntityId" },
        "gameweek_entity_prefix": {
          "type": "string",
          "pattern": "^sensor\\.[a-z0-9_]+_$"
        },
        "table_entity": { "$ref": "#/$defs/sensorEntityId" }
      }
    },
    "school": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classroom_students", "calendar_entities", "scopay_calendar_entities"],
      "properties": {
        "classroom_students": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["person_id", "assignments_entity"],
            "properties": {
              "person_id": { "$ref": "#/$defs/id" },
              "assignments_entity": { "$ref": "#/$defs/sensorEntityId" }
            }
          }
        },
        "calendar_entities": {
          "type": "array",
          "items": { "$ref": "#/$defs/calendarEntityId" }
        },
        "scopay_calendar_entities": {
          "type": "array",
          "items": { "$ref": "#/$defs/calendarEntityId" }
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities", "hours_to_show"],
      "properties": {
        "entities": {
          "type": "array",
          "items": { "$ref": "#/$defs/personEntityId" }
        },
        "hours_to_show": { "type": "integer", "minimum": 0, "maximum": 24 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_camera_id", "cameras", "garage"],
      "properties": {
        "primary_camera_id": { "$ref": "#/$defs/id" },
        "cameras": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "entity_id", "role"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "name": { "type": "string", "minLength": 1, "maxLength": 40 },
              "entity_id": { "$ref": "#/$defs/cameraEntityId" },
              "role": { "enum": ["doorbell", "driveway", "garden", "other"] },
              "motion_entity": { "$ref": "#/$defs/binarySensorEntityId" },
              "person_entity": { "$ref": "#/$defs/binarySensorEntityId" },
              "ringing_entity": { "$ref": "#/$defs/binarySensorEntityId" },
              "start_stream_entity": { "$ref": "#/$defs/buttonEntityId" },
              "stop_stream_entity": { "$ref": "#/$defs/buttonEntityId" }
            }
          }
        },
        "garage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cover_entity", "camera_id"],
          "properties": {
            "cover_entity": { "$ref": "#/$defs/coverEntityId" },
            "camera_id": { "$ref": "#/$defs/id" },
            "motion_entity": { "$ref": "#/$defs/binarySensorEntityId" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "icon": { "type": "string", "pattern": "^mdi:[a-z0-9-]+$" },
    "entityId": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*\\.[a-z0-9_]+$" },
    "calendarEntityId": { "type": "string", "pattern": "^calendar\\.[a-z0-9_]+$" },
    "weatherEntityId": { "type": "string", "pattern": "^weather\\.[a-z0-9_]+$" },
    "todoEntityId": { "type": "string", "pattern": "^todo\\.[a-z0-9_]+$" },
    "lightEntityId": { "type": "string", "pattern": "^light\\.[a-z0-9_]+$" },
    "coverEntityId": { "type": "string", "pattern": "^cover\\.[a-z0-9_]+$" },
    "climateEntityId": { "type": "string", "pattern": "^climate\\.[a-z0-9_]+$" },
    "sceneEntityId": { "type": "string", "pattern": "^scene\\.[a-z0-9_]+$" },
    "mediaPlayerEntityId": { "type": "string", "pattern": "^media_player\\.[a-z0-9_]+$" },
    "sensorEntityId": { "type": "string", "pattern": "^sensor\\.[a-z0-9_]+$" },
    "cameraEntityId": { "type": "string", "pattern": "^camera\\.[a-z0-9_]+$" },
    "vacuumMapCameraEntityId": { "type": "string", "pattern": "^camera\\.[a-z0-9_]*map[a-z0-9_]*$" },
    "personEntityId": { "type": "string", "pattern": "^person\\.[a-z0-9_]+$" },
    "binarySensorEntityId": { "type": "string", "pattern": "^binary_sensor\\.[a-z0-9_]+$" },
    "buttonEntityId": { "type": "string", "pattern": "^button\\.[a-z0-9_]+$" },
    "colour": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "localAssetUrl": {
      "type": "string",
      "pattern": "^/local/family-dashboard/[A-Za-z0-9._/-]+$"
    },
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": 0, "maximum": 100 },
        { "type": "number", "minimum": 0, "maximum": 100 }
      ],
      "minItems": 2,
      "maxItems": 2
    }
  }
}
