{
  "$schema": "./family-dashboard.schema.json",
  "schema_version": 2,
  "product": {
    "title": "Family Dashboard",
    "locale": "en-GB",
    "timezone": "Europe/London"
  },
  "display": {
    "orientation": "landscape",
    "kiosk": true,
    "legacy_ios": true,
    "default_view": "today",
    "panel_path": "family-dashboard"
  },
  "theme": {
    "accent": "#5B5BD6",
    "background": "#F3F1EC",
    "surface": "#FFFFFF",
    "text": "#202432",
    "muted": "#697080",
    "radius_px": 20
  },
  "people": [
    {
      "id": "parent",
      "name": "Parent",
      "role": "parent",
      "colour": "#5B5BD6"
    },
    {
      "id": "child_one",
      "name": "Child one",
      "role": "child",
      "colour": "#E76F51"
    },
    {
      "id": "child_two",
      "name": "Child two",
      "role": "child",
      "colour": "#2A9D8F"
    }
  ],
  "features": {
    "calendar": true,
    "home": true,
    "music": true,
    "chores": true,
    "football": true,
    "lists": true,
    "weather": true,
    "school": false
  },
  "calendar": {
    "card_type": "custom:daylight-calendar-card",
    "default_view": "week-standard",
    "rolling_days": 7,
    "entities": [
      {
        "id": "family",
        "entity_id": "calendar.family",
        "label": "Family",
        "colour": "#5B5BD6",
        "person_ids": [
          "parent",
          "child_one",
          "child_two"
        ]
      }
    ]
  },
  "weather": {
    "entity_id": "weather.home"
  },
  "lists": {
    "reminders_entity": "todo.reminders",
    "shopping_entity": "todo.shopping_list"
  },
  "rooms": [
    {
      "id": "living_room",
      "name": "Living room",
      "area_id": "living_room",
      "icon": "mdi:sofa-outline",
      "lights": [
        "light.living_room"
      ],
      "covers": [
        "cover.living_room"
      ],
      "climate": "climate.living_room"
    }
  ],
  "media": {
    "card_type": "custom:mediocre-multi-media-player-card",
    "initial_player": "media_player.living_room",
    "players": [
      {
        "entity_id": "media_player.living_room",
        "name": "Living room",
        "ma_entity_id": "media_player.living_room_music_assistant",
        "can_be_grouped": true
      }
    ]
  },
  "chores": {
    "profile": "legacy-lite",
    "users": [
      {
        "person_id": "child_one",
        "dashboard_helper_entity": "sensor.child_one_choreops_ui_dashboard_helper",
        "points_entity": "sensor.child_one_choreops_points",
        "chores_entity": "sensor.child_one_choreops_chores"
      },
      {
        "person_id": "child_two",
        "dashboard_helper_entity": "sensor.child_two_choreops_ui_dashboard_helper",
        "points_entity": "sensor.child_two_choreops_points",
        "chores_entity": "sensor.child_two_choreops_chores"
      }
    ]
  },
  "football": {
    "card_type": "custom:teamtracker-card",
    "entities": [
      {
        "entity_id": "sensor.team_tracker",
        "label": "Premier League"
      }
    ]
  },
  "school": {
    "entities": []
  }
}
